<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- avvisi di allerta, sensori e chiusure (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- vibrazione dell'allarme sonoro -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- facoltativa, chiesta solo toccando "La mia posizione" sulla mappa -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- i controlli periodici delle notifiche non vengono rimandati dal risparmio batteria -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- aggiornamenti scaricati dalle release di GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CastelSafe">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.UpdateReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.AlarmStopReceiver"
            android:exported="false" />

        <!-- widget della schermata Home -->
        <receiver
            android:name=".widget.AllertaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_allerta">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_allerta" />
        </receiver>
        <activity
            android:name=".widget.SensoriWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_sensori">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widget.GraficoWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_grafico">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.GraficoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_grafico">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_grafico" />
        </receiver>
        <activity
            android:name=".widget.RadarWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_radar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.RadarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_radar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_radar" />
        </receiver>
        <receiver
            android:name=".widget.SensoriWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sensori">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sensori" />
        </receiver>
    </application>
</manifest>
